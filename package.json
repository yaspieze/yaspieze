{
  "name": "yaspieze-site",
  "private": true,
  "version": "1.0.0",
  "description": "Static artist website with TypeScript-powered interactions",
  "scripts": {
    "build": "esbuild src/site.ts --bundle --minify --format=iife --target=es2020 --outfile=fresh/site.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "lenis": "^1.3.27"
  }
}
